{
	"manifest_version": 3,
	"name": "Bordo",
	"version": "0.1.0",
	"minimum_chrome_version": "127",
	"description": "Save pages, selected text and images as notes in Bordo.",
	"key": "",
	"icons": {
		"16": "icons/bordo-mark-16.png",
		"32": "icons/bordo-mark-32.png",
		"48": "icons/bordo-mark-48.png",
		"128": "icons/bordo-mark-128.png"
	},
	"permissions": [
		"activeTab",
		"scripting",
		"storage",
		"contextMenus",
		"sidePanel",
		"identity"
	],
	"optional_host_permissions": [
		"https://*/*",
		"http://127.0.0.1/*",
		"http://localhost/*"
	],
	"background": {
		"service_worker": "worker.js",
		"type": "module"
	},
	"action": {
		"default_title": "Save to Bordo",
		"default_popup": "clip.html",
		"default_icon": {
			"16": "icons/bordo-mark-16.png",
			"32": "icons/bordo-mark-32.png",
			"48": "icons/bordo-mark-48.png",
			"128": "icons/bordo-mark-128.png"
		}
	},
	"side_panel": {
		"default_path": "clip.html?panel"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+A"
			}
		}
	}
}
